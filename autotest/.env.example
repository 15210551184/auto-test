# 复制成 .env 并填写真实账号密码
# .env 已加入 .gitignore，不会被提交

# 被测系统的登录账号密码（配置里用 ${env:AUTOTEST_USER} / ${env:AUTOTEST_PASS} 引用）
# 只测一个系统、或多个系统共用同一账号时，用这一对就够了
AUTOTEST_USER=your_account
AUTOTEST_PASS=your_password

# 多个系统账号不一样：各自起一对变量名，新建系统时账号/密码框填 ${env:变量名} 引用，
# 不要把真实密码直接填进网页表单（会明文存进 projects/<系统>/project.yaml）
# SYSA_USER=account_a
# SYSA_PASS=password_a
# SYSB_USER=account_b
# SYSB_PASS=password_b

# 控制台自己的访问口令（跟上面被测系统的账号无关）。没登录会跳转到登录页。
# 部署到公网服务器必须配置，否则任何人打开端口就能操作；留空则不校验，仅适合本地临时使用。
WEB_USER=admin
WEB_PASS=change_me

# 登录态签名密钥（选填）。不填就每次启动随机生成，重启后需要重新登录；
# 固定填一串随机字符串可以让重启/重新部署后登录态不丢。
# SECRET_KEY=换成一长串随机字符串
